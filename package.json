{
  "name": "lastyear",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c red,blue \"tsx watch --clear-screen=false src/server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm test",
    "build:bookmarklet": "tsx scripts/build-bookmarklet.ts",
    "fixture:payload": "tsx scripts/fixture-payload.ts",
    "render:stories": "tsx scripts/render-stories.ts",
    "render:edge": "tsx scripts/render-edge-cases.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.10.1",
    "typescript": "~6.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fastify/static": "^10.1.11",
    "@fontsource/arimo": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "esbuild": "^0.28.2",
    "fastify": "^5.12.8",
    "linebreak": "^1.1.0",
    "opentype.js": "^2.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "wouter": "^3.13.0",
    "zod": "^4.6.7"
  }
}
