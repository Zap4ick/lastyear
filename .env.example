# Copy to .env and fill in. .env is git-ignored.

# Free key from https://www.last.fm/api/account/create (only "Application name" is required).
# Without it the app still works, but can't check usernames or fetch genres.
LASTFM_API_KEY=

# Public URL of the app. The bookmarklet sends people back here.
# Local dev: the Vite dev server. Production: your https domain.
APP_URL=http://localhost:5173

# API server port (Vite proxies /api and /b.js here in dev).
API_PORT=8787

# SQLite file.
DB_PATH=data/lastyear.db
